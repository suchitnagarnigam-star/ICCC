# Server Network
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Neon Cloud PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/mcl_iccc?sslmode=require
PGSSLMODE=require

# Authentication & Session (365-day persistent login)
JWT_SECRET=mcl_iccc_super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=365d

# SLA Engine Configuration
SLA_TARGET_WORKING_HOURS=48
SLA_CLOCK_START_EVENT=SUBMITTED
MCL_WORK_DAY_START=09:00
MCL_WORK_DAY_END=17:00
MCL_TIMEZONE=Asia/Kolkata

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mcl.gov.in

# Google Drive Storage Proxy
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_EVIDENCE_FOLDER_ID=

